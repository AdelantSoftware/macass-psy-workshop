{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "macass-psy-workshop",
	"compatibility_date": "2026-07-28",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "macass-psy-workshop"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "macass-psy-workshop-opennext-cache"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"routes": [
		{
			"pattern": "voce.adelant.tech/*",
			"zone_name": "adelant.tech"
		}
	],
	"workers_dev": true
}